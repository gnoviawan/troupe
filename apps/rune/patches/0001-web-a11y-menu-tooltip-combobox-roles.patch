From 33a0e308131aa3d13c55f3fa2a62c986e64b8ffa Mon Sep 17 00:00:00 2001
From: Troupe <troupe-patches@localhost>
Date: Tue, 24 Nov 2026 01:55:03 +0100
Subject: [PATCH] a11y(web): mirror menus, tooltips and comboboxes with their
 ARIA roles

The web mirror wrote role="menuitem" rows with no menu around them,
dropped a tooltip's role, and mirrored a select's trigger as a plain
button. Make menu and tooltip role-carrying containers, give combobox
the control role that option and menuitem have, and name a mirrored
combobox with aria-label, since a combobox takes no name from its
content.

Upstream issue: drafted in Troupe's R4c report, not filed yet.
---
 crates/rune/src/a11y/roles.rs          | 6 +++---
 crates/rune/src/platform/web/bridge.js | 3 +++
 2 files changed, 6 insertions(+), 3 deletions(-)

diff --git a/crates/rune/src/a11y/roles.rs b/crates/rune/src/a11y/roles.rs
index 34c9019..23b5abc 100644
--- a/crates/rune/src/a11y/roles.rs
+++ b/crates/rune/src/a11y/roles.rs
@@ -144,7 +144,7 @@ pub(crate) const ROLES: &[RoleSpec] = &[
     RoleSpec::role("link", Role::Link).warn_nameless().pointer(),
     RoleSpec::role("menuitem", Role::MenuItem).warn_nameless().web_control().pointer(),
     RoleSpec::role("radio", Role::RadioButton).warn_nameless().web_control().pointer(),
-    RoleSpec::role("menu", Role::Menu),
+    RoleSpec::role("menu", Role::Menu).aria_container(),
     RoleSpec::role("status", Role::Status).live(LiveRegion::Polite),
     RoleSpec::role("tree", Role::Tree),
     RoleSpec::role("main", Role::Main).container("main"),
@@ -155,7 +155,7 @@ pub(crate) const ROLES: &[RoleSpec] = &[
     RoleSpec::role("radiogroup", Role::RadioGroup),
     RoleSpec::role("progressbar", Role::ProgressIndicator),
     RoleSpec::role("note", Role::Note),
-    RoleSpec::role("combobox", Role::ComboBox).warn_nameless().pointer(),
+    RoleSpec::role("combobox", Role::ComboBox).warn_nameless().web_control().pointer(),
     RoleSpec::role("gridcell", Role::GridCell),
     RoleSpec::role("code", Role::Code),
     RoleSpec::role("columnheader", Role::ColumnHeader).aria_container(),
@@ -167,7 +167,7 @@ pub(crate) const ROLES: &[RoleSpec] = &[
     RoleSpec::role("grid", Role::Grid),
     RoleSpec::new("none", AkRole::Omit),
     RoleSpec::role("img", Role::Image),
-    RoleSpec::role("tooltip", Role::Tooltip),
+    RoleSpec::role("tooltip", Role::Tooltip).aria_container(),
     RoleSpec::role("canvas", Role::Canvas),
     RoleSpec::role("document", Role::Document),
     RoleSpec::role("figure", Role::Figure).container("figure"),
diff --git a/crates/rune/src/platform/web/bridge.js b/crates/rune/src/platform/web/bridge.js
index 209bcea..d291981 100644
--- a/crates/rune/src/platform/web/bridge.js
+++ b/crates/rune/src/platform/web/bridge.js
@@ -991,6 +991,9 @@ export function syncA11y(h, json) {
                 if (value === undefined) el.removeAttribute(name);
                 else if (el.getAttribute(name) !== value) el.setAttribute(name, value);
             }
+            // A combobox takes no name from its content (ARIA), so it carries its label.
+            if (item.o === 'combobox' && item.t) el.setAttribute('aria-label', item.t);
+            else el.removeAttribute('aria-label');
         }
         if (item.k === 'group' || item.k === 'image') {
             if (item.t) el.setAttribute('aria-label', item.t); else el.removeAttribute('aria-label');
-- 
