From 9ba0ffbb49a316cfc0958b69c5c06af82f680956 Mon Sep 17 00:00:00 2001
From: Troupe <troupe@example.invalid>
Date: Wed, 25 Nov 2026 08:36:33 +0100
Subject: [PATCH] fix(web): mirror a terminal grid's rows as lines of text

The web accessibility mirror skipped grid elements: a grid has no text of its
own, so a terminal's screen never reached screen readers or Find in the
browser, while the native tree reads each row as a text run. Mirror each
non-blank row the grid shows as a text item at its row's place, in the row's
font.

Upstream issue: drafted in Troupe's apps/rune/patches/README.md, not filed.
---
 crates/rune/src/runtime/web/a11y.rs       | 27 +++++++++++++++++++++++
 crates/rune/src/runtime/web/a11y_tests.rs | 12 ++++++++++
 2 files changed, 39 insertions(+)

diff --git a/crates/rune/src/runtime/web/a11y.rs b/crates/rune/src/runtime/web/a11y.rs
index 15274b0d..0e62e700 100644
--- a/crates/rune/src/runtime/web/a11y.rs
+++ b/crates/rune/src/runtime/web/a11y.rs
@@ -515,6 +515,33 @@ impl RuntimeCore {
                     continue;
                 }
             }
+            // A terminal grid has no text of its own: its rows are its lines, mirrored top to
+            // bottom as the native tree's text runs are, so a reader and Find see the screen.
+            if !in_control && let Some(g) = n.vis.grid.as_deref().filter(|_| rect[2] > 0.0 && rect[3] > 0.0) {
+                let [cw, ch] = g.cell;
+                let shown = g.rows.len().min((rect[3] / ch.max(1.0)).ceil() as usize);
+                for (k, row) in g.rows.iter().take(shown).enumerate() {
+                    let (text, _) = row.reading();
+                    if text.trim().is_empty() { continue; }
+                    let at = [rect[0], rect[1] + k as f32 * ch, f32::from(g.cols) * cw, ch];
+                    let mut item = A11yItem::new("text", &format!("{}/row-{k}", n.path), at);
+                    let style = row.line.style;
+                    item.font_size = round1(style.size);
+                    item.text = text;
+                    item.font = Some(A11yFont {
+                        family: family_name(style.family),
+                        weight: style.weight,
+                        line_height: round1(ch),
+                        tracking: style.tracking,
+                        italic: style.italic,
+                        align: "left",
+                    });
+                    push(&mut out, item);
+                }
+                i = end;
+                last_flow_parent = None;
+                continue;
+            }
             if !in_control && let Some(spec) = n.text.as_deref().filter(|t| !t.redacted && rect[2] > 0.0 && rect[3] > 0.0) {
                 let runs = text_runs(&n.path, spec);
                 let selectable = spec.selectable || selects.get(i).copied().unwrap_or(false);
diff --git a/crates/rune/src/runtime/web/a11y_tests.rs b/crates/rune/src/runtime/web/a11y_tests.rs
index 35690f30..892b0f27 100644
--- a/crates/rune/src/runtime/web/a11y_tests.rs
+++ b/crates/rune/src/runtime/web/a11y_tests.rs
@@ -641,3 +641,15 @@ fn web_a11y_mirror_omits_secure_fields_labels_and_containers() {
         assert_eq!(btn.text, "Reveal", "button label must omit secure descendant text");
     }
 }
+
+#[test]
+fn mirrors_a_terminal_grids_rows_as_lines_of_text() {
+    fn view(_: &(), _: &mut Cx<()>) -> El {
+        let row = |s: &str| std::rc::Rc::new(crate::GridRow::new(s, vec![], crate::tok::type_::BODY));
+        crate::col().child(crate::grid(20, 8.0, 19.0, vec![row("$ ls"), row(""), row("hello  world")]).size(160.0, 57.0))
+    }
+    let mut rt = Runtime::new((), view, (480.0, 320.0), Env::default());
+    rt.frame(0.0);
+    let rows: Vec<(&str, String, [f32; 4])> = rt.web_a11y_items().into_iter().map(|i| (i.kind, i.text, i.rect)).collect();
+    assert_eq!(rows, [("text", "$ ls".to_owned(), [0.0, 0.0, 160.0, 19.0]), ("text", "hello  world".to_owned(), [0.0, 38.0, 160.0, 19.0])]);
+}
